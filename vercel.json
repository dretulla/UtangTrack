{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/staticfiles/tracker/sw.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/staticfiles/tracker/icons/icon-192.png"
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}